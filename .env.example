# ==============================================================================
# CampusAI Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=CampusAI
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=campusai_user
POSTGRES_PASSWORD=campusai_secure_pass
POSTGRES_DB=campusai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://campusai_user:campusai_secure_pass@localhost:5432/campusai_db

# Security & Authentication
JWT_SECRET_KEY=campusai_super_secret_jwt_key_minimum_32_characters_for_security_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Bedrock LLM & Embeddings Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.2
# When set to true, uses high-fidelity local AI responses & deterministic mock tools
# if real AWS Bedrock credentials are unavailable or region access is disabled.
AWS_BEDROCK_MOCK_FALLBACK=true

# Amazon S3 Document Storage
AWS_S3_BUCKET_DOCUMENTS=campusai-academic-documents-prod
AWS_S3_ENDPOINT_URL=

# Speech Services (AWS Polly / Transcribe / Local Fallback)
AWS_POLLY_VOICE_EN=Aditi
AWS_POLLY_VOICE_HI=Aditi
AWS_POLLY_ENGINE=neural
SPEECH_SERVICE_ENABLED=true

# Model Context Protocol (MCP) Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_API_KEY=campusai_mcp_secure_token_key_2026

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8001
